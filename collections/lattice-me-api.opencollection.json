{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lattice HRIS Competencies Me API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.latticehq.com/v2/me"
          },
          "docs": "Returns information about the current user associated with the provided API token."
        }
      ]
    }
  ],
  "bundled": true
}