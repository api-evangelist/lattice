{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lattice HRIS Competencies API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Competencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get competency by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.latticehq.com/v2/competency/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The competency identifier"
              }
            ]
          },
          "docs": "Returns a competency with the given id. If cannot find competency, returns a 404."
        }
      ]
    }
  ],
  "bundled": true
}